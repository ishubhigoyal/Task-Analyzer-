# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY=""

# JWT Secrets - MUST be unique, long, and kept secret in production
JWT_SECRET="replace-with-a-very-long-and-random-secret-string"
JWT_REFRESH_SECRET="replace-with-another-very-long-and-random-secret-string"

# NODE_ENV: Set to 'production' on Railway
NODE_ENV="development"

# PORT: Railway assigns this automatically
PORT=3000

# DATABASE_URL: Set your MongoDB connection string here.
# For local MongoDB: "mongodb://localhost:27017/teamtask?authSource=admin"
DATABASE_URL="mongodb://localhost:27017/""
